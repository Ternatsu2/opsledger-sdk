# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 4
  metrics: count: path: 7
  metrics: count: method: 7

  entity: audit: {
    path: "/api/v1/audit": {
      op: list: method: *GET
    }
  }

  entity: case: {
    path: "/api/v1/cases": {
      op: list: method: *GET
    }
    path: "/api/v1/cases/{case_id}": {
      rename: param: "case_id": *"id"
      op: load: method: *GET
    }
  }

  entity: dashboard: {
    path: "/api/v1/dashboard": {
      op: list: method: *GET
    }
  }

  entity: system: {
    path: "/api/v1/system": {
      op: load: method: *GET
    }
    path: "/health": {
      op: load: method: *GET
    }
    path: "/ready": {
      op: load: method: *GET
    }
  }

}