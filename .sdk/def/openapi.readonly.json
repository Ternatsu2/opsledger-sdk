      "CaseCreate": {
        "properties": {
          "legal_business_name": {
            "type": "string",
            "maxLength": 180,
            "minLength": 2,
            "title": "Legal Business Name"
          },
          "trading_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 180
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Name"
          },
          "registration_number": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Registration Number"
          },
          "jurisdiction": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Jurisdiction"
          },
          "industry": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Industry"
          },
          "requested_amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Requested Amount"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "default": "XCD"
          },
          "funding_purpose": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 10,
            "title": "Funding Purpose"
          },
          "annual_revenue": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Annual Revenue"
          },
          "contact_name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Contact Name"
          },
          "contact_email": {
            "type": "string",
            "format": "email",
            "title": "Contact Email"
          }
        },
        "type": "object",
        "required": [
          "legal_business_name",
          "registration_number",
          "jurisdiction",
          "industry",
          "requested_amount",
          "funding_purpose",
          "annual_revenue",
          "contact_name",
          "contact_email"
        ],
        "title": "CaseCreate"
      },
